{
  "name": "@sadw1q/ruo",
  "version": "0.85.1-ruo.1",
  "description": "Coding agent CLI with read, bash, edit, write tools and session management",
  "type": "module",
  "piConfig": {
    "configDir": ".ruo",
    "name": "ruo"
  },
  "bin": {
    "ruo": "dist/bundle/cli.js",
    "ruo-setup": "scripts/setup.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc-entry": {
      "import": "./dist/bundle/rpc-entry.js"
    }
  },
  "files": [
    "dist",
    "extensions",
    "themes",
    "scripts",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "!**/codere.md",
    "!**/*.map"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/setup.test.mjs",
    "check": "node dist/bundle/cli.js --version"
  },
  "dependencies": {
    "@earendil-works/chord": "^0.85.1",
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "chalk": "5.6.2",
    "cross-spawn": "7.0.6",
    "diff": "8.0.4",
    "grok-mermaid": "0.2.2",
    "highlight.js": "10.7.3",
    "hosted-git-info": "9.0.3",
    "ignore": "7.0.5",
    "jiti": "2.7.0",
    "minimatch": "10.2.5",
    "proper-lockfile": "4.1.2",
    "semver": "7.8.0",
    "typebox": "1.3.7",
    "undici": "8.9.0",
    "yaml": "2.9.0"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "rimraf": "6.1.2",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  },
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9"
  },
  "keywords": [
    "coding-agent",
    "ai",
    "llm",
    "cli",
    "tui",
    "agent"
  ],
  "author": "Mario Zechner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadw1q/ruo.git"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
